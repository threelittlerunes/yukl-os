{
  "version": 1,
  "commands": {
    "build": "npm run build",
    "test": "npm run test",
    "format": "npm run format"
  },
  "folders": {
    "contracts": ".orchestration/contracts",
    "intents": ".orchestration/intents",
    "locks": ".orchestration/locks",
    "artifacts": ".orchestration/artifacts"
  },
  "allowlist": ["npm run build", "npm run test"],
  "lifecycle": {
    "runtimes": {
      "implement": { "adapter": "orca", "agent": "opencode" },
      "audit": { "adapter": "orca", "agent": "antigravity" },
      "review": { "adapter": "orca", "agent": "antigravity" }
    },
    "vcs": "vcs-github",
    "stateDir": ".orchestration/state"
  }
}

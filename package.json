{
  "name": "yukl-os",
  "version": "2.0.0",
  "description": "A power-based governance harness for the Orca Agentic SDLC. Maps French & Raven's bases of power and Yukl's influence tactics onto deterministic pipeline constraints.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "author": "threelittlerunes",
  "repository": {
    "type": "git",
    "url": "https://github.com/threelittlerunes/yukl-os.git"
  },
  "homepage": "https://github.com/threelittlerunes/yukl-os#readme",
  "bugs": {
    "url": "https://github.com/threelittlerunes/yukl-os/issues"
  },
  "files": [
    "flow.config.json",
    "orca.yaml",
    ".yukl-intent.yml",
    "INTENT.md",
    "scripts/",
    ".claude/",
    ".orchestration/artifacts/",
    ".orchestration/contracts/.gitkeep",
    ".orchestration/locks/.gitkeep",
    "docs/",
    "biome.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/validate-config.js",
    "test": "node scripts/count-instructions.js && node --test tests/config.test.js tests/rules.test.js",
    "test:config": "node --test tests/config.test.js tests/rules.test.js",
    "test:budget": "node scripts/count-instructions.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "js-yaml": "^4.1.0"
  },
  "keywords": ["orca", "agentic-sdlc", "yukl", "power-harness", "ai-governance"]
}
